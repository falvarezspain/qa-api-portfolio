    "/api/checkout": {
      "post": {
        "tags": [
          "Redirecciones"
        ],
        "summary": "Redirigir checkout temporal",
        "security": [
          {
            "DemoBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sku",
                  "quantity"
                ],
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                }
              },
              "examples": {
                "valid": {
                  "summary": "Pedido válido",
                  "value": {
                    "sku": "SKU-100",
                    "quantity": 1
                  }
                },
                "noStock": {
                  "summary": "Producto sin stock",
                  "value": {
                    "sku": "SKU-200",
                    "quantity": 1
                  }
                },
                "invalid": {
                  "summary": "Cantidad fuera de rango",
                  "value": {
                    "sku": "SKU-100",
                    "quantity": 0
                  }
                },
                "malformed": {
                  "summary": "JSON malformado",
                  "value": "{\"sku\":"
                }
              }
            }
          }
        },
        "description": "Casos: [RED-03](./casos.html#RED-03)",
        "responses": {
          "307": {
            "description": "Redirección temporal con el mismo método",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                },
                "example": "/api/orders"
              }
            }
          }
        }
      }
    },
