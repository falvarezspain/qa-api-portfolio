{
  "openapi": "3.0.3",
  "info": {
    "title": "QA API Portfolio · Tienda demo",
    "version": "1.0.0",
    "description": "Laboratorio de pruebas black-box. [Ver matriz y pasos](./casos.html). Usa **Authorize** e ingresa `demo-buyer` para crear pedidos, `demo-reader` para probar permisos o `demo-other` para verificar aislamiento. Reinicia el servidor para recuperar el stock inicial. El navegador puede seguir las redirecciones automáticamente."
  },
  "servers": [
    {
      "url": "."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Comprobar estado operativo",
        "description": "Casos: [CAT-01](./casos.html#CAT-01) · [RES-01](./casos.html#RES-01)",
        "responses": {
          "200": {
            "description": "Operación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result",
                    "data"
                  ],
                  "properties": {
                    "result": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "up"
                          ]
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "CAT-01-1": {
                    "summary": "CAT-01 · Estado operativo del servicio",
                    "value": {
                      "result": "OK",
                      "data": {
                        "status": "up"
                      }
                    }
                  },
                  "RES-01-2": {
                    "summary": "RES-01 · Error interno controlado",
                    "value": {
                      "result": "OK",
                      "data": {
                        "status": "up"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Catálogo"
        ],
        "summary": "Consultar catálogo y caché",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "description": "Envíalo para validar el snapshot del catálogo.",
            "schema": {
              "type": "string"
            },
            "example": "\"catalog-v1\""
          }
        ],
        "description": "Casos: [CAT-02](./casos.html#CAT-02) · [CAT-03](./casos.html#CAT-03) · [CAT-04](./casos.html#CAT-04) · [RED-01](./casos.html#RED-01)",
        "responses": {
          "200": {
            "description": "Operación exitosa",
            "headers": {
              "etag": {
                "schema": {
                  "type": "string"
                },
                "example": "\"catalog-v1\""
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result",
                    "data"
                  ],
                  "properties": {
                    "result": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    }
                  }
                },
                "examples": {
                  "CAT-02-1": {
                    "summary": "CAT-02 · Catálogo con datos y ETag",
                    "value": {
                      "result": "OK",
                      "data": [
                        {
                          "id": "SKU-100",
                          "name": "Teclado",
                          "stock": 5
                        },
                        {
                          "id": "SKU-200",
                          "name": "Ratón",
                          "stock": 0
                        }
                      ]
                    }
                  },
                  "CAT-04-1": {
                    "summary": "CAT-04 · Caché obsoleta recibe el catálogo completo",
                    "value": {
                      "result": "OK",
                      "data": [
                        {
                          "id": "SKU-100",
                          "name": "Teclado",
                          "stock": 5
                        },
                        {
                          "id": "SKU-200",
                          "name": "Ratón",
                          "stock": 0
                        }
                      ]
                    }
                  },
                  "RED-01-2": {
                    "summary": "RED-01 · Catálogo antiguo redirige de forma permanente",
                    "value": {
                      "result": "OK",
                      "data": [
                        {
                          "id": "SKU-100",
                          "name": "Teclado",
                          "stock": 5
                        },
                        {
                          "id": "SKU-200",
                          "name": "Ratón",
                          "stock": 0
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Snapshot sin cambios",
            "headers": {
              "etag": {
                "schema": {
                  "type": "string"
                },
                "example": "\"catalog-v1\""
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "tags": [
          "Redirecciones"
        ],
        "summary": "Consultar el catálogo por su ruta anterior",
        "description": "Casos: [RED-01](./casos.html#RED-01)",
        "responses": {
          "301": {
            "description": "Redirección permanente",
            "headers": {
              "location": {
                "schema": {
