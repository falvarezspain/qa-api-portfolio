              "idempotency-replayed": {
                "schema": {
                  "type": "string"
                },
                "example": "true"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result",
                    "data"
                  ],
                  "properties": {
                    "result": {
