                  "sku": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                }
              },
              "examples": {
                "valid": {
                  "summary": "Pedido válido",
                  "value": {
                    "sku": "SKU-100",
                    "quantity": 1
